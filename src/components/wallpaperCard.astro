---
interface Props {
  image: string;
  title: string;
}

const { image, title } = Astro.props;
---

<div
  class="group relative overflow-hidden rounded-2xl bg-neutral-100"
>
  <!-- Wallpaper -->
  <img
    src={image}
    alt={title}
    loading="lazy"
    decoding="async"
    class="block h-auto w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.4]"
  />

  <!-- Download Button -->
  <a
    href={image}
    download
    aria-label={`Download ${title}`}
    class="absolute bottom-5 left-1/2 z-20
           flex h-12 w-12 -translate-x-1/2 translate-y-2
           items-center justify-center
           overflow-hidden rounded-full
           border border-white/35
           bg-white/15
           text-white
           opacity-0
           shadow-[0_8px_32px_rgba(0,0,0,0.20)]
           backdrop-blur-2xl
           backdrop-saturate-200
           transition-all duration-500
           ease-[cubic-bezier(.22,1,.36,1)]
           group-hover:translate-y-0
           group-hover:w-40
           group-hover:opacity-100
           group-hover:border-white/50
           group-hover:bg-white/20
           hover:scale-[1.04]
           hover:bg-white/30
           hover:shadow-[0_10px_35px_rgba(0,0,0,0.25)]
           active:scale-[0.98]"
  >
    <!-- Download Icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.8"
      stroke="currentColor"
      class="h-5 w-5 shrink-0 transition-transform duration-300 ease-out group-hover:translate-y-[1px]"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 3v12m0 0 4-4m-4 4-4-4m-5 8h14"
      />
    </svg>

    <!-- Button Text -->
    <span
      class="ml-2 whitespace-nowrap font-mono text-sm"
    >
      Download
    </span>
  </a>
</div>