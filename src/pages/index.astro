---
import "../styles/global.css";

const wallpaper = {
  title: "Minimalist Wallpaper",
  image: "/wallpaper/wallpaper.jpg",
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{wallpaper.title}</title>
  </head>

  <body class="min-h-screen bg-white text-black">
    <main class="mx-auto flex min-h-screen max-w-4xl flex-col items-center justify-center px-6">

      <img
        src={wallpaper.image}
        alt={wallpaper.title}
        class="w-full rounded-2xl"
      />

      <h1 class="mt-6 text-2xl font-medium">
        {wallpaper.title}
      </h1>

      <a
        href={wallpaper.image}
        download
        class="mt-4 rounded-lg bg-black px-6 py-3 text-sm font-medium text-white"
      >
        Download Wallpaper
      </a>

    </main>
  </body>
</html>